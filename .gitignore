# Ignore build artifacts and dependencies
node_modules/
backend/dist/
frontend/dist/

# Ignore log files
*.log

# Ignore temporary files
*.tmp

# Ignore environment file
.env

# Ignore credentials file
credentials.json

# Ignore docker compose file
docker-compose.yml

# Ignore Docker credentials directory
.docker/creds/

# Temporary typedoc output
.typedoc-tmp/

# Firebase CLI cache
.firebase/

