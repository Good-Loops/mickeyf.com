{
    "servers": {
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "X-MCP-Toolsets": "repos,pull_requests,issues,actions,code_security,dependabot,secret_protection",
                "X-MCP-Readonly": "true",
                "X-MCP-Lockdown": "true"
            }
        },
        "firebase": {
            "type": "stdio",
            "command": "node",
            "args": [
                "${workspaceFolder}/.github/firebase-deploy/node_modules/firebase-tools/lib/bin/firebase.js",
                "mcp",
                "--dir",
                "${workspaceFolder}",
                "--only",
                "auth",
                "--tools",
                "firebase_get_environment,firebase_get_project,auth_get_users"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_OPTIONS": "--use-system-ca"
            }
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@0.0.79",
                "--isolated"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_OPTIONS": "--use-system-ca"
            }
        }
    }
}
