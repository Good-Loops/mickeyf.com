.main-menu-toolkit-pilot {
    background-color: black;
}

.main-menu-toolkit-pilot .pilot-menu-button {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    color: white;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition-property: color, scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.main-menu-toolkit-pilot .pilot-menu-button:focus {
    color: white;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.4);
}

.main-menu-toolkit-pilot .pilot-menu-button:hover {
    color: rgb(255, 242, 230);
    scale: 1.045 1.045;
    text-shadow: 0 0 8px rgba(255, 81, 50, 0.85);
}

.main-menu-toolkit-pilot .pilot-menu-button:focus #pilot-audio-icon {
    opacity: 0.85;
}

#pilot-audio-icon {
    transition-property: scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.main-menu-toolkit-pilot #pilot-audio-button:hover #pilot-audio-icon {
    scale: 1.15 1.15;
    opacity: 1;
}

.main-menu-toolkit-pilot .pilot-menu-button:active {
    opacity: 0.8;
    scale: 0.98 0.98;
}

.main-menu-toolkit-pilot .pilot-menu-button:disabled {
    opacity: 0.45;
    scale: 1 1;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.main-menu-toolkit-pilot #pilot-audio-button:disabled #pilot-audio-icon {
    scale: 1 1;
}
