.main-menu-toolkit-pilot {
    background-color: black;
}

.main-menu-toolkit-pilot .pilot-menu-button {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    color: rgb(227, 232, 240);
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.main-menu-toolkit-pilot .pilot-menu-button:hover {
    background-color: rgba(255, 50, 30, 0.12);
}

.main-menu-toolkit-pilot .pilot-menu-button:focus {
    border-width: 2px;
    border-color: rgb(255, 184, 160);
}

.main-menu-toolkit-pilot .pilot-menu-button:active {
    background-color: rgba(255, 50, 30, 0.25);
}

.main-menu-toolkit-pilot .pilot-menu-button:disabled {
    opacity: 0.45;
}
