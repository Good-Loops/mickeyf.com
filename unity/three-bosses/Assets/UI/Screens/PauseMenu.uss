.pause-ui {
    position: absolute;
    -unity-font-definition: url("../../Art/UI/Fonts/Oxanium-Bold.ttf");
    color: rgb(230, 245, 255);
}

.pause-overlay {
    display: none;
    position: absolute;
    background-color: rgba(1, 3, 5, 0.34);
}

.pause-panel {
    position: absolute;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(7, 21, 31, 0.94);
    border-color: rgba(124, 207, 226, 0.7);
    border-width: 1px;
    border-radius: 18px;
}

.pause-title {
    flex-shrink: 0;
    height: 56px;
    margin-bottom: 12px;
    font-size: 38px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.pause-ui .pause-button {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-image: none;
    background-color: rgba(27, 54, 67, 0.92);
    border-color: rgba(152, 219, 235, 0.55);
    border-width: 1px;
    border-radius: 9px;
    color: rgb(230, 245, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.pause-ui .pause-action {
    width: 240px;
    max-width: 100%;
    min-height: 48px;
    height: 50px;
    font-size: 22px;
    letter-spacing: 1px;
}

.pause-ui .pause-secondary {
    margin-top: 9px;
    font-size: 19px;
}

.pause-ui .pause-opener {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
}

.pause-icon-bar {
    width: 5px;
    height: 21px;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 1px;
    background-color: rgb(230, 245, 255);
}

.pause-ui .pause-button:hover,
.pause-ui .pause-button:focus {
    border-color: rgb(201, 242, 252);
    background-color: rgb(34, 76, 92);
    color: white;
}

.pause-ui .pause-button:active {
    background-color: rgb(21, 54, 67);
    color: rgb(161, 222, 238);
}

.pause-ui .pause-button:disabled {
    opacity: 0.5;
}
