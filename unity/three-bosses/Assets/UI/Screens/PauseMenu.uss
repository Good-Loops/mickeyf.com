.pause-ui {
    position: absolute;
    -unity-font-definition: url("../../Art/UI/Fonts/Oxanium-Bold.ttf");
    color: rgb(230, 245, 255);
}

.pause-overlay {
    display: none;
    position: absolute;
    background-color: rgba(1, 3, 5, 0.34);
}

.pause-panel {
    position: absolute;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: transparent;
    border-width: 0;
}

.pause-title {
    flex-shrink: 0;
    height: 56px;
    margin-bottom: 12px;
    font-size: 38px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.pause-ui .pause-button {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-image: none;
    background-color: transparent;
    border-width: 0;
    color: rgb(230, 245, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.pause-action-frame {
    flex-shrink: 0;
    width: 240px;
    max-width: 100%;
    min-height: 48px;
    height: 50px;
}

.pause-ui .pause-action {
    width: 100%;
    height: 100%;
    min-height: 48px;
    font-size: 22px;
    letter-spacing: 1px;
}

.pause-secondary-frame {
    margin-top: 9px;
}

.pause-ui .pause-secondary {
    font-size: 19px;
}

.pause-ui .pause-opener {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.pause-icon-bar {
    width: 4px;
    height: 16px;
    margin-left: 2.5px;
    margin-right: 2.5px;
    border-radius: 2px;
    background-color: rgba(219, 240, 247, 0.92);
}

.pause-ui .pause-button:hover,
.pause-ui .pause-button:focus {
    background-color: transparent;
    border-width: 0;
    color: white;
}

.pause-ui .pause-button:active {
    background-color: transparent;
    border-width: 0;
    color: rgb(161, 222, 238);
}

.pause-ui .pause-button:disabled {
    opacity: 0.5;
}
