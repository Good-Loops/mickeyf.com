.outcome-screen {
    background-color: black;
    color: white;
}

#outcome-artwork {
    -unity-background-scale-mode: stretch-to-fill;
    overflow: visible;
}

.outcome-text, .outcome-button {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.outcome-text {
    white-space: nowrap;
    overflow: visible;
}

.caption-backing {
    background-color: black;
}

.outcome-screen .outcome-button {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    color: rgb(227, 232, 240);
    white-space: nowrap;
    padding-left: 4px;
    padding-right: 4px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition-property: color, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.outcome-screen .outcome-button:hover {
    color: rgb(255, 242, 230);
    text-shadow: 0 0 6px rgba(255, 112, 80, 0.9);
}

.outcome-screen .outcome-button:focus {
    color: rgb(255, 184, 160);
}

.outcome-screen .outcome-button:active {
    opacity: 0.8;
}

.outcome-screen .outcome-button:disabled {
    opacity: 0.45;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

#outcome-fade {
    background-color: black;
}
