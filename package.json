{
	"name": "mickeyf-root",
	"private": true,
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=22.15.0 <23.0.0",
		"npm": ">=11.0.0 <12.0.0"
	},
	"scripts": {
		"infra:up": "docker compose -f compose.yaml up -d cloud-sql-proxy",
		"infra:down": "docker compose -f compose.yaml down",
		"backend:dev:local": "npm run infra:up && concurrently --kill-others-on-fail --names proxy,watch,server --prefix-colors yellow,magenta,red \"docker compose -f compose.yaml logs --tail=20 -f cloud-sql-proxy\" \"npm --prefix backend run watch\" \"node scripts/wait-for-port.mjs 127.0.0.1 3306 60000 && npm --prefix backend run dev\"",
		"frontend:dev:local": "concurrently --kill-others --passthrough-arguments --names webgl,front --prefix-colors blue,cyan \"npm run three-bosses:webgl:serve\" \"node scripts/wait-for-port.mjs 127.0.0.1 4174 10000 && npm --prefix frontend run dev:vite -- {@}\" --",
		"three-bosses:webgl:build": "node scripts/build-three-bosses-webgl.mjs",
		"three-bosses:webgl:release:build": "node scripts/build-three-bosses-webgl.mjs --release",
		"three-bosses:webgl:package": "node scripts/package-three-bosses-webgl-release.mjs",
		"three-bosses:webgl:release:validate": "node scripts/package-three-bosses-webgl-release.mjs --validate-packaged",
		"three-bosses:webgl:hosting:verify": "node scripts/verify-three-bosses-webgl-hosting.mjs",
		"three-bosses:webgl:preview:smoke": "npm --prefix .github/firebase-deploy run three-bosses:webgl:preview:smoke --",
		"three-bosses:webgl:serve": "node scripts/serve-three-bosses-webgl.mjs",
		"test:three-bosses-webgl-build": "node --test scripts/build-three-bosses-webgl.test.mjs",
		"test:three-bosses-webgl-package": "node --test scripts/package-three-bosses-webgl-release.test.mjs",
		"test:three-bosses-webgl-server": "node --test scripts/serve-three-bosses-webgl.test.mjs",
		"test:three-bosses-webgl-hosting": "node --test scripts/verify-three-bosses-webgl-hosting.test.mjs",
		"test:three-bosses-webgl-smoke": "npm --prefix .github/firebase-deploy run test:three-bosses-webgl-smoke",
		"test:cloudbuild-candidate": "node --test scripts/cloudbuild-candidate.test.mjs",
		"docs:clean": "node scripts/clean-docs.mjs",
		"docs:json:frontend": "typedoc --options frontend/typedoc.json --tsconfig frontend/tsconfig.typedoc.json --json .typedoc-tmp/frontend.json",
		"docs:json:backend": "typedoc --options backend/typedoc.json --tsconfig backend/tsconfig.typedoc.json --json .typedoc-tmp/backend.json",
		"docs:json": "npm run docs:json:frontend && npm run docs:json:backend",
		"docs:assets": "node scripts/copy-doc-assets.mjs",
		"docs:build": "typedoc --options typedoc.merge.json && npm run docs:assets",
		"docs": "npm run docs:clean && npm run docs:json && npm run docs:build",
		"docs:serve": "http-server docs -p 8081",
		"docs:watch": "chokidar \"typedoc.merge.json\" \"docs-src/index.md\" \"docs-src/typedoc.css\" \"docs-src/assets/**/*\" \"frontend/ts/**/*.ts\" \"frontend/ts/**/*.tsx\" \"backend/ts/**/*.ts\" -c \"npm run docs\"",
		"docs:dev": "concurrently \"npm:docs:watch\" \"npm:docs:serve\"",
		"docs:dev:fresh": "npm run docs && npm run docs:dev",
		"hooks:install": "git config core.hooksPath .githooks",
		"test:unity-yaml-normalizer": "node --test scripts/normalize-unity-yaml-whitespace.test.mjs",
		"unity:yaml:normalize-staged": "node scripts/normalize-unity-yaml-whitespace.mjs --staged"
	},
	"devDependencies": {
		"chokidar-cli": "^3.0.0",
		"concurrently": "^10.0.4",
		"http-server": "^14.1.1",
		"typedoc": "^0.28.20"
	}
}
