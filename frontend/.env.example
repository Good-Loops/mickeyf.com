# ==============================
# API Endpoints
# ==============================

VITE_DEV_API_URL=http://localhost:8080
VITE_PROD_API_URL=https://your-backend-url.run.app

# Explicit real-account/score preview at http://localhost:5173 only.
# 0 keeps authentication and submissions on the isolated development backend.
VITE_USE_PUBLIC_API=0

# Local-only Unity WebGL prototype. Keep disabled unless the external build and
# loopback asset server are available.
VITE_ENABLE_THREE_BOSSES_LOCAL=0
