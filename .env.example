# ==============================
# Environment
# ==============================

NODE_ENV=development

# ==============================
# Backend Server
# ==============================

BACKEND_PORT=8080

# Fail-closed operational gate. Only the exact value "true" enables p4-Vega
# score writes; keep false unless local submission testing is intentional.
P4_VEGA_SCORE_SUBMISSIONS_ENABLED=false

# Fail-closed Three Bosses gate. The complete run endpoint may be exercised
# locally only when this exact value is "true". Keep the local default false;
# production is configured and verified separately by the deployment workflow.
THREE_BOSSES_RUN_SUBMISSIONS_ENABLED=false

# Provider login remains off until its schema, scoped grants and provider clients
# are approved. Set only the supported clients for the target; no client secrets.
PROVIDER_AUTH_ENABLED=false
# GOOGLE_WEB_CLIENT_ID=your-client.apps.googleusercontent.com
# APPLE_IOS_BUNDLE_ID=com.mickeyf.app

# Account deletion remains off until independent recovery protection and the
# production rollout are approved. Real journal use requires production mode;
# isolated tests inject a fake journal and never write local IDs to the bucket.
ACCOUNT_DELETION_ENABLED=false
# Explicit approved destination required when enabled; do not enable locally.
ACCOUNT_DELETION_JOURNAL_BUCKET=
# Original 0008 migration applied_at (UTC, six fractional digits), captured
# outside SQL at approved activation. Never derive it from a restored database.
# Required only when deletion is enabled; no live value is committed here.
ACCOUNT_IDENTITY_EPOCH=

# ==============================
# Database (Cloud SQL via Proxy)
# ==============================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# Cloud SQL (used in production / proxy)
CLOUD_SQL_CONNECTION_NAME=project:region:instance

# Host path to Application Default Credentials for the local proxy.
# Leave blank to use the native Windows %APPDATA% default.
# Set an absolute Windows path only when the credentials live elsewhere.
# Never commit the credential file itself.
GOOGLE_APPLICATION_CREDENTIALS_HOST=

# ==============================
# Security
# ==============================

# Use a cryptographically random value. Production requires at least 32
# characters; never commit the real value.
SESSION_SECRET=replace_with_at_least_32_random_characters
