# ==============================
# Environment
# ==============================

NODE_ENV=development

# ==============================
# Backend Server
# ==============================

BACKEND_PORT=8080

# Fail-closed operational gate. Only the exact value "true" enables p4-Vega
# score writes; keep false unless local submission testing is intentional.
P4_VEGA_SCORE_SUBMISSIONS_ENABLED=false

# ==============================
# Database (Cloud SQL via Proxy)
# ==============================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# Cloud SQL (used in production / proxy)
CLOUD_SQL_CONNECTION_NAME=project:region:instance

# Host path to Application Default Credentials for the local proxy.
# Leave blank to use the native Windows %APPDATA% default.
# Set an absolute Windows path only when the credentials live elsewhere.
# Never commit the credential file itself.
GOOGLE_APPLICATION_CREDENTIALS_HOST=

# ==============================
# Security
# ==============================

# Use a cryptographically random value. Production requires at least 32
# characters; never commit the real value.
SESSION_SECRET=replace_with_at_least_32_random_characters
