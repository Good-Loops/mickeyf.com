{
    "name": "backend",
    "version": "0.5.0",
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=22.0.0 <23.0.0",
        "npm": ">=11.0.0 <12.0.0"
    },
    "scripts": {
        "test": "tsc -p tsconfig.json --noEmit",
        "test:unit": "node --test -r ts-node/register ts/config/runtimeConfig.test.ts ts/middleware/apiResponseSecurity.test.ts ts/middleware/errorHandling.test.ts ts/security/mainController.security.test.ts ts/security/p4VegaScorePolicy.test.ts ts/security/requestAuthentication.test.ts ts/security/requestRateLimits.test.ts ts/security/scoreSubmissionAuthorization.test.ts ts/security/userRequestValidation.test.ts",
        "watch": "webpack --mode development --watch",
        "prod": "webpack --mode production",
        "dev": "nodemon dist/server.min.js",
        "docs:json": "typedoc --options typedoc.json"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^16.4.5",
        "express": "^4.22.2",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.23.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.12.5",
        "node-loader": "^2.0.0",
        "nodemon": "^3.1.0",
        "ts-loader": "^9.4.2",
        "ts-node": "^10.9.1",
        "typescript": "^5.9.3",
        "webpack": "^5.104.1",
        "webpack-cli": "^5.0.2",
        "webpack-node-externals": "^3.0.0"
    }
}
